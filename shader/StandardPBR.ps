#version 450
//https://www.shadertoy.com/view/ld3SRr 

#include "CommonSets.inl"
#include "PBREntity.h"


#include "CommonMath.inl"
#include "CommonLight.inl"

DECL_RBUFFER_STD430_BEG(PBRDataAlias)
    PBRData pbrData;
DECL_RBUFFER_STD430_END

RESOURCE_DECL_BEG(4)
    SLOT_TEXTURE(4,         texture2D,      u_baseColorTex)
    SLOT_SAMPLER(4,         sampler,        u_baseColorSampler)
    SLOT_TEXTURE(4,         texture2D,      u_normalTex)
    SLOT_SAMPLER(4,         sampler,        u_normalSampler)
    SLOT_TEXTURE(4,         texture2D,      u_metallicRoughnessTex)
    SLOT_SAMPLER(4,         sampler,        u_metallicRoughnessSampler)
    SLOT_TEXTURE(4,         texture2D,      u_AOTex)
    SLOT_SAMPLER(4,         sampler,        u_AOSampler)
    SLOT_CONST_BUFFER(4,    PBRDataAlias,   CBUFFER_pbrData)
RESOURCE_DECL_END

#define PBRDATA         GetBuffer(CBUFFER_pbrData).pbrData

layout(location = 0) in vec3 i_worldPos;
layout(location = 1) in vec3 i_normal;
layout(location = 2) in vec3 i_tangent;
layout(location = 3) in vec3 i_bitangent;
layout(location = 4) in vec2 i_texcoord0;
layout(location = 5) in vec3 i_color;
layout(location = 6) in vec3 i_viewDir;

layout(location = 0) out vec4 outColor;

float DistributionGGX(vec3 N, vec3 H, float roughness)
{
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;

    float nom   = a2;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    denom = PI * denom * denom;

    return nom / max(denom, 0.0000001); 
}

float GeometrySchlickGGX(float NdotV, float roughness)
{
    float r = (roughness + 1.0);
    float k = (r * r) / 8.0; 

    float nom   = NdotV;
    float denom = NdotV * (1.0 - k) + k;

    return nom / denom;
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    float ggx2 = GeometrySchlickGGX(NdotV, roughness);
    float ggx1 = GeometrySchlickGGX(NdotL, roughness);

    return ggx1 * ggx2;
}

vec3 PBR_DirectLight(vec3 V, vec3 L, vec3 N, vec3 albedo, float metallic, float roughness,vec3 F0, vec3 radiance)
{
    vec3 H = normalize(V + L);
    
    float NdotL = max(dot(N, L), 0.0); 
    float NdotV = max(dot(N, V), 0.0); 
    float HdotV = max(dot(H, V), 0.0);

    float D = DistributionGGX(N, H, roughness);   
    float G = GeometrySmith(N, V, L, roughness);      
    vec3  F = FresnelSchlick(HdotV, F0);       

    vec3 numerator    = D * G * F; 
    float denominator = 4.0 * NdotV * NdotL + 0.0001; 
    vec3 specular     = numerator / denominator;

    vec3 kS = F;
    vec3 kD = vec3(1.0) - kS;
    kD *= (1.0 - metallic);	  
    return (kD * albedo / PI + specular) * radiance * NdotL;
}

vec3 PBR_LightCalc(vec3 pos,vec3 albedo,vec3 V, vec3 N, float roughness, const float metallic){
    vec3 col = vec3(0.f,0.f,0.f);
    vec3 F0 = CalcF0(albedo, metallic);
    for( int i = 0;i < int(LIGHTDATA.sceneLightInfo.x);++i ){
        GPULightData light = LIGHTDATA.lights[i];
        vec3 lightPos = vec3(light.positionType.xyz);
        int lightType = int(light.positionType.w);
        vec3 lightColor = pow(light.colorIntensity.xyz,vec3(2.2));
        vec3 radiance = lightColor * light.colorIntensity.w;
        if(lightType == 0){
            //Dir
            vec3 L = light.directionRange.xyz;
            col += PBR_DirectLight(V,L,N,albedo,metallic,roughness,F0,radiance);
        }else{
            //Spot/Point
            vec3 L = normalize(lightPos - pos);
            float radius = light.directionRange.w;
            float distance = length(lightPos - pos);
            float distance2 = distance * distance;
            float attenuation = 1.0 / (distance2 + 1.0);
            float factor = distance / radius;
            float factor4 = factor * factor * factor * factor; // ^4
            float window = clamp(1.0 - factor4, 0.0, 1.0);
            float fadeFactor = attenuation * (window * window);
            col += PBR_DirectLight(V,L,N,albedo,metallic,roughness,F0,radiance * fadeFactor);
        }
    }

    vec3 specularLightIBL = IBLCalculate(V,N,F0,roughness);
    return col + specularLightIBL;
}

vec3 ApplyNormalMap(vec3 N, vec3 normalSample, float normalScale)
{
    vec3 n = normalSample * 2.0 - 1.0;
    n.xy *= normalScale;
    return normalize(mix(N, n, normalScale > 0.0 ? 1.0 : 0.0));
}

vec3 fromTangentSpaceToWorld(vec3 vector){
    return vector.x * i_tangent + 
           vector.y * i_bitangent + 
           vector.z * i_normal;
}

void main()
{
    vec2 uvBase = i_texcoord0;
    vec2 uvMR   = i_texcoord0;
    vec2 uvN    = i_texcoord0;
    vec2 uvAO   = i_texcoord0;
    bool useBaseCol = (PBRDATA.texControl.x >= 0.);
    bool useMR      = (PBRDATA.texControl.y >= 0.);
    bool useN       = (PBRDATA.texControl.z >= 0.);
    bool useAO      = (PBRDATA.texControl.w >= 0.);
    // --------------------------------------------------
    // Base Color
    // --------------------------------------------------
    vec4 baseColor = PBRDATA.baseCol;
    baseColor.xyz = pow(baseColor.xyz,vec3(2.2));
    if(useBaseCol){
        vec4 texColor = texture(
            GetSampledTexture(u_baseColorTex, u_baseColorSampler),
            uvBase
        );
        #ifdef ALPHA_TEST
        if(texColor.w > PBRDATA.alphaClipBar){
            discard; 
        }
        #endif //ALPHA_TEST
        texColor.xyz = pow(texColor.xyz,vec3(2.2));
        baseColor *= texColor;
    }
    vec3 albedo = baseColor.rgb;

    // --------------------------------------------------
    // Metallic / Roughness
    // --------------------------------------------------
    float metallic  = PBRDATA.metalRoughAO.x;
    float roughness = PBRDATA.metalRoughAO.y;
    if(useMR){
        vec4 mrSample = texture(
            GetSampledTexture(u_metallicRoughnessTex, u_metallicRoughnessSampler),
            uvMR
        );

        metallic  *= mrSample.b; // metallic
        roughness *= mrSample.g; // roughness

        metallic  = clamp(metallic, 0.0, 1.0);
        roughness = clamp(roughness, 0.04, 1.0);
    }
    // --------------------------------------------------
    // Normal
    // --------------------------------------------------
    vec3 N = normalize(i_normal);
    if(useN){
        float normalScale = PBRDATA.metalRoughAO.w;

        vec3 normalSample = texture(
            GetSampledTexture(u_normalTex, u_normalSampler),
            uvN
        ).xyz;

        vec3 n = normalSample * 2.0 - vec3(1.0);
        n.xy *= normalScale;
        N = normalize(n);
    }

    // --------------------------------------------------
    // View vector
    // --------------------------------------------------
    vec3 V = normalize(CAMDATA.CameraPosition.xyz - i_worldPos);

    // --------------------------------------------------
    // Direct lighting (USING YOUR FUNCTION)
    // --------------------------------------------------
    vec3 directLight = PBR_LightCalc(
        i_worldPos,
        albedo,
        V,
        N,
        roughness,
        metallic
    ).rgb;

    // --------------------------------------------------
    // Ambient Occlusion (ENGINE-LEVEL APPLY)
    // --------------------------------------------------
    float ao = PBRDATA.metalRoughAO.z;
    if(useAO){
        ao *= texture(
            GetSampledTexture(u_AOTex, u_AOSampler),
            uvAO
        ).r;
    }
    directLight *= ao;

    // --------------------------------------------------
    // Emissive
    // --------------------------------------------------
    vec3 emissive = pow(PBRDATA.emissiveFactor.xyz,vec3(2.2));

    // --------------------------------------------------
    // Final
    // --------------------------------------------------
    vec3 color = directLight + emissive;
    color.xyz= pow(color.xyz,vec3(1./2.2));
    outColor = vec4(color, baseColor.a);
}
