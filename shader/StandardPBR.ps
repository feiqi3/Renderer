#version 450
//https://www.shadertoy.com/view/ld3SRr 

#include "CommonSets.inl"
#include "PBREntity.h"

layout(set = 2, binding = 1) uniform UniformBufferObject {
    PBRData pbrData
} CBUFFER_pbrData;

layout(set = 2, binding = 2) uniform texture2D      u_baseColorTex;
layout(set = 2, binding = 3) uniform sampler        u_baseColorSampler;
layout(set = 2, binding = 4) uniform texture2D      u_normalTex;
layout(set = 2, binding = 5) uniform sampler        u_normalSampler;
layout(set = 2, binding = 6) uniform texture2D      u_metallicRoughnessTex;
layout(set = 2, binding = 7) uniform sampler        u_metallicRoughnessSampler;
layout(set = 2, binding = 8) uniform texture2D      u_AOTex;
layout(set = 2, binding = 9) uniform sampler        u_AOSampler;

layout(location = 0) in vec3 i_worldPos;
layout(location = 1) in vec3 i_normal;
layout(location = 2) in vec2 i_texcoord0;
layout(location = 3) in vec3 i_texcoord1;
layout(location = 4) in vec3 i_color;
layout(location = 5) out vec3 i_viewDir;


const float PI = 3.14159265359;

float DistributionGGX(vec3 N, vec3 H, float roughness)
{
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float NdotH2 = NdotH * NdotH;

    float nom   = a2;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    denom = PI * denom * denom;

    return nom / max(denom, 0.0000001); 
}

float GeometrySchlickGGX(float NdotV, float roughness)
{
    float r = (roughness + 1.0);
    float k = (r * r) / 8.0; 

    float nom   = NdotV;
    float denom = NdotV * (1.0 - k) + k;

    return nom / denom;
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    float ggx2 = GeometrySchlickGGX(NdotV, roughness);
    float ggx1 = GeometrySchlickGGX(NdotL, roughness);

    return ggx1 * ggx2;
}

vec3 FresnelSchlick(float cosTheta, vec3 F0)
{
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

vec3 PBR_DirectLight(vec3 V, vec3 L, vec3 N, vec3 albedo, float metallic, float roughness, vec3 radiance)
{
    vec3 H = normalize(V + L);
    
    float NdotL = max(dot(N, L), 0.0); 
    float NdotV = max(dot(N, V), 0.0); 
    float HdotV = max(dot(H, V), 0.0);

    vec3 F0 = vec3(0.04); 
    F0 = mix(F0, albedo, metallic);

    float D = DistributionGGX(N, H, roughness);   
    float G = GeometrySmith(N, V, L, roughness);      
    vec3  F = FresnelSchlick(HdotV, F0);       

    vec3 numerator    = D * G * F; 
    float denominator = 4.0 * NdotV * NdotL + 0.0001; 
    vec3 specular     = numerator / denominator;

    vec3 kS = F;
    vec3 kD = vec3(1.0) - kS;
    kD *= (1.0 - metallic);	  
    return (kD * albedo / PI + specular) * radiance * NdotL;
}

vec4 PBR_LightCalc(vec3 pos,vec3 V, vec3 N, float roughness, const float metallic){
    vec3 col = vec3(0.f,0.f,0.f);
    for(int i = 0;i < (int)LIGHTDATA.sceneLightInfo.x;++i){
        GPULightData light = LIGHTDATA.lights[i];
        vec3 lightPos = vec3(light.positionType.xyz);
        int lightType = int(light.lightType.w);
        vec3 radiance = light.colorIntensity.xyz * light.colorIntensity.w;
        if(lightType == 0){
            //Dir
            vec3 L = light.directionRange.xyz;
            col += PBR_DirectLight(V,L,N,metallic,roughness,radiance);
        }else{
            //Spot/Point
            vec3 L = lightPos - pos;
            float radius = light.directionRange.w;
            float distance2 = (lightPos - pos) * (lightPos - pos);
            float attenuation = 1.0 / (distance2 + 1.0);
            float factor = distance / radius;
            float factor4 = factor * factor * factor * factor; // ^4
            float window = clamp(1.0 - factor4, 0.0, 1.0);
            float fadeFactor = attenuation * (window * window);
            col += PBR_DirectLight(V,L,N,metallic,roughness,radiance * fadeFactor);
        }
    }
    return col;
}
vec2 SelectUV(float useUV1)
{
    return (useUV1 == 0.0) ? i_texcoord0 : i_texcoord1.xy;
}

vec3 ApplyNormalMap(vec3 N, vec3 normalSample, float normalScale)
{
    vec3 n = normalSample * 2.0 - 1.0;
    n.xy *= normalScale;
    return normalize(mix(N, n, normalScale > 0.0 ? 1.0 : 0.0));
}

vec4 main()
{
    // --------------------------------------------------
    // UV selection (texControl: 0 -> uv0, !=0 -> uv1)
    // --------------------------------------------------
    vec2 uvBase = SelectUV(PBRDATA.texControl.x);
    vec2 uvMR   = SelectUV(PBRDATA.texControl.y);
    vec2 uvN    = SelectUV(PBRDATA.texControl.z);
    vec2 uvAO   = SelectUV(PBRDATA.texControl.w);
    bool useBaseCol = (PBRDATA.texControl.x >= 0.);
    bool useMR      = (PBRDATA.texControl.y >= 0.);
    bool useN       = (PBRDATA.texControl.z >= 0.);
    bool useAO      = (PBRDATA.texControl.w >= 0.);
    // --------------------------------------------------
    // Base Color
    // --------------------------------------------------
    vec4 baseColor = PBRDATA.baseCol;
    if(useBaseCol){
        baseColor *= texture(
            sampler2D(u_baseColorTex, u_baseColorSampler),
            uvBase
        );
    }
    vec3 albedo = baseColor.rgb;

    // --------------------------------------------------
    // Metallic / Roughness
    // --------------------------------------------------
    float metallic  = PBRDATA.metalRoughAO.x;
    float roughness = PBRDATA.metalRoughAO.y;
    if(useMR){
        vec4 mrSample = texture(
            sampler2D(u_metallicRoughnessTex, u_metallicRoughnessSampler),
            uvMR
        );

        metallic  *= mrSample.b; // metallic
        roughness *= mrSample.g; // roughness

        metallic  = clamp(metallic, 0.0, 1.0);
        roughness = clamp(roughness, 0.04, 1.0);
    }
    // --------------------------------------------------
    // Normal
    // --------------------------------------------------
    vec3 N = normalize(i_normal);
    if(useN){
        float normalScale = PBRDATA.metalRoughAO.w;

        vec3 normalSample = texture(
            sampler2D(u_normalTex, u_normalSampler),
            uvN
        ).xyz;

        vec3 n = normalSample * 2.0 - 1.0;
        n.xy *= normalScale;
    }
    N = normalize(n);

    // --------------------------------------------------
    // View vector
    // --------------------------------------------------
    vec3 V = normalize(CAMDATA.position.xyz - i_worldPos);

    // --------------------------------------------------
    // Direct lighting (USING YOUR FUNCTION)
    // --------------------------------------------------
    vec3 directLight = PBR_LightCalc(
        i_worldPos,
        V,
        N,
        roughness,
        metallic
    ).rgb;

    // --------------------------------------------------
    // Ambient Occlusion (ENGINE-LEVEL APPLY)
    // --------------------------------------------------
    float ao = PBRDATA.metalRoughAO.z;
    if(useAO){
        ao *= texture(
            sampler2D(u_AOTex, u_AOSampler),
            uvAO
        ).r;
    }
    directLight *= ao;

    // --------------------------------------------------
    // Emissive
    // --------------------------------------------------
    vec3 emissive = PBRDATA.emissiveFactor.xyz;

    // --------------------------------------------------
    // Final
    // --------------------------------------------------
    vec3 color = directLight + emissive;
    return vec4(color, baseColor.a);
}
