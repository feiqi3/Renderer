#version 450
#include "SkyBoxData.h"
#include "CommonSets.inl"


layout(set = 4,binding = 0)uniform ObjectUniformData{
    SkyBoxData data;
}skyboxData;

#define SKYBOX skyboxData.data 

layout(set = 4,binding = 1)uniform textureCube SkyboxCubeMap;
layout(set = 4,binding = 2)uniform sampler cubemapSampler;

layout(location = 0) in vec2 v_uv;
layout(location = 1) in vec3 o_viewDir;

layout(location = 0) out vec4 fragColor;

void main() {
    vec4 cubemapAlbedo = texture(samplerCube(SkyboxCubeMap,cubemapSampler),o_viewDir);

    if(SKYBOX.isHDR.x < 0.5){
        //Not HDR
        cubemapAlbedo.rgb = pow(cubemapAlbedo.rgb,vec3(2.2));
    }
    vec3 exposureColor = (cubemapAlbedo.rgb * SKYBOX.colorexposureTuning.rgb * vec3(SKYBOX.colorexposureTuning.w));

    fragColor.xyz = pow(exposureColor,vec3(1./2.2));

    fragColor.w = 1;
}