#version 450
#include "ShaderResource.inl"
#include "BindlessSet.inl"
#include "imgui.fwd"

layout(location = 0) in vec2    i_pos;
layout(location = 1) in vec2    i_uv;
layout(location = 2) in vec4    i_color;
layout(location = 3) flat in int i_texId;
layout(location = 4) flat in vec4 i_scissor;

layout(location = 0) out vec4 o_col;

void main(){
    if(i_pos.x < i_scissor.x || 
       i_pos.x > i_scissor.z ||
       i_pos.y < i_scissor.y || 
       i_pos.y > i_scissor.w
    ){
        discard;
    }

    vec4 texCol = texture(
        GetSampledTextureByIdx(i_texId,u_sampler),
        i_uv
    );
    o_col = i_color * texCol;
}