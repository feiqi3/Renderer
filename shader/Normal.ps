#version 450
#include "CommonSets.inl"

layout(location = 0) in vec3 fragNormal;
layout(location = 1) in vec2 fragTexCoord;
layout(location = 2) in vec3 worldPos;

layout(location = 0) out vec4 outColor;
layout(set = 3, binding = 1) uniform texture2D BoxTex;
layout(set = 3, binding = 2) uniform sampler  BoxSampler;

void main()
{

    vec3 virtualLightPos = vec3(3,3,3);


    vec3 baseColor = vec3(0.3, 0.6, 1.0);

    float lighting = dot(normalize(fragNormal), normalize(virtualLightPos - worldPos));
    vec4 normalColor = vec4( (normalize(fragNormal)  + vec3(1.,1.,1.)) / 2., 1.0);
    vec4 textureColor = texture(sampler2D(BoxTex,BoxSampler),fragTexCoord);
    textureColor.a = 1.0;

    outColor = normalColor * textureColor;
}